# YOLO 模型設定
# 預設使用 yolo11n.pt，您可以更換為其他訓練好的模型路徑
YOLO_MODEL=yolo11n.pt

# 即時通報功能控制 (true/false)
ENABLE_DISCORD=false
ENABLE_LINE=false

# Discord Webhook 設定
# 請在您的 Discord 伺服器頻道中建立 Webhook，並將網址填於下方
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# LINE Notify 設定
# 請至 LINE Notify 官網 (https://notify-bot.line.me/) 申請個人/群組 Token 並填於下方
LINE_NOTIFY_TOKEN=YOUR_LINE_NOTIFY_TOKEN

# 警報冷飪時間 (單位：毫秒)，預設為 10000 毫秒 (10 秒)，避免同類型違規短時間重複洗版
NOTIFICATION_COOLDOWN=10000

# Gemini API Key (生成安全分析報告使用)
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
